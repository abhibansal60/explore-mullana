---
import { site } from "./data";
const { title, description, path = "/", image = "/og/home.png" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site.url + path} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.url + image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1b19" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anek+Devanagari:wdth,wght@75..100,400..700&family=Anek+Latin:wdth,wght@75..100,400..800&display=swap"
    />
  </head>
  <body>
    <slot />
    <script is:inline>
      // Anonymous tap counter: sends only {slug, kind}. Never blocks navigation.
      document.addEventListener("click", (e) => {
        try {
          const el = e.target.closest("[data-tap]");
          const slug = el && el.closest("[data-slug]")?.dataset.slug;
          if (slug) navigator.sendBeacon("/api/tap", new Blob([JSON.stringify({ slug, kind: el.dataset.tap })], { type: "application/json" }));
        } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #fafaf8;
    --sheet: #ffffff;
    --ink: #1c1b19;
    --muted: #68645c;
    --line: #e6e3dc;
    --stone: #f2b705; /* Haryana kilometre-stone yellow */
    --open: #1e7a3a;
    --focus: #1f5aa6;
    --font: "Anek Latin", "Anek Devanagari", system-ui, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #1b1b19; --sheet: #232320; --ink: #efece6; --muted: #a39e94;
      --line: #36352f; --open: #5cc27a; --focus: #7fb0ff;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font: 400 17px/1.45 var(--font); font-variation-settings: "wdth" 100;
  }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  [hidden] { display: none !important; }

  /* Signboard lettering: condensed and heavy, like painted shop boards. */
  .board { font-weight: 750; font-variation-settings: "wdth" 78; letter-spacing: 0; line-height: 1.02; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    min-height: 44px; padding: 0 14px; border-radius: 6px;
    border: 1px solid var(--line); background: var(--sheet); color: var(--ink);
    font: 600 15px/1 var(--font); text-decoration: none; cursor: pointer; white-space: nowrap;
  }
  .btn svg { width: 18px; height: 18px; flex: none; }
  .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn:active { transform: translateY(1px); }

  /* Icon-only action button used in list rows. */
  .ib {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none;
    border-radius: 8px; border: 1px solid var(--line); background: var(--sheet); color: var(--ink);
  }
  .ib svg { width: 20px; height: 20px; }
  .ib.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ib:active { transform: translateY(1px); }

  /* Compact list row: name and status on the left, icon buttons on the right. */
  .row {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px;
    padding: 12px 0 12px 16px; border-bottom: 1px solid var(--line); scroll-margin-top: 30vh;
  }
  .row::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 4px; border-radius: 2px; background: var(--cat); }
  .row.place::before { background: none; border: 1.5px solid var(--cat); }
  .row.picked { background: color-mix(in srgb, var(--cat) 8%, transparent); }
  .row .main { display: block; min-width: 0; text-decoration: none; }
  .row h2 { margin: 0; overflow-wrap: anywhere; }
  .row .sub { display: flex; flex-wrap: wrap; column-gap: 12px; align-items: baseline; font-size: 14px; color: var(--muted); margin-top: 2px; line-height: 1.35; }
  .row .sub .open-badge { font-size: 14px; }
  .row .sub .dist { font-weight: 600; color: var(--ink); }
  .row .acts { display: flex; gap: 8px; }

  .open-badge { font-size: 15px; font-weight: 600; white-space: nowrap; }
  .open-badge.is-open { color: var(--open); }
  .open-badge.is-closed { color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
  }
</style>
