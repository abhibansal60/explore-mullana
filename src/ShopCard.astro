---
import Icon from "./Icon.astro";
import { categories, directions, searchText, time12, type Shop } from "./data";
const { shop } = Astro.props as { shop: Shop };
const c = categories[shop.category];
---
<article class="row" style={`--cat:${c.color}`} data-slug={shop.slug} data-cat={shop.category} data-search={searchText(shop)} data-lat={shop.lat} data-lng={shop.lng}>
  <a class="main" href={`/shop/${shop.slug}/`}>
    <h2 class="board">{shop.name}</h2>
    <span class="sub">
      <span class="catname">{c.en}</span>
      <span class="open-badge" data-open={shop.hours.open} data-close={shop.hours.close}
        data-open-label={time12(shop.hours.open)} data-close-label={time12(shop.hours.close)}></span>
      <span class="dist" hidden></span>
    </span>
  </a>
  <div class="acts">
    <a class="ib primary" data-tap="call" href={`tel:+91${shop.phones[0]}`} aria-label={`Call ${shop.name}`} title={`Call ${shop.name}`}><Icon name="call" /></a>
    {shop.whatsapp && <a class="ib" data-tap="whatsapp" href={`https://wa.me/91${shop.phones[0]}`} aria-label={`WhatsApp ${shop.name}`} title={`WhatsApp ${shop.name}`}><Icon name="chat" /></a>}
    <a class="ib" data-tap="directions" href={directions(shop)} aria-label={`Directions to ${shop.name}`} title={`Directions to ${shop.name}`}><Icon name="route" /></a>
  </div>
</article>

<style>
  h2 { font-size: 21px; }
</style>
