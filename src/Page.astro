---
// Shell for the guide pages: back to the map, a signboard title, the page, a WhatsApp share.
import Layout from "./Layout.astro";
import Credits from "./Credits.astro";
import Icon from "./Icon.astro";
import { site } from "./data";

const { title, hi, intro, description, path, color = "var(--stone)" } = Astro.props as {
  title: string; hi?: string; intro?: string; description: string; path: string; color?: string;
};
const share = `${title}, Mullana: ${site.url}${path}`;
---
<Layout title={`${title}, Mullana`} description={description} path={path}>
  <main class="page" style={`--cat:${color}`}>
    <a class="back" href="/"><Icon name="back" />All of Mullana</a>
    <header class="sign">
      <h1 class="board">{title}</h1>
      {hi && <p class="hi" lang="hi">{hi}</p>}
      {intro && <p class="intro">{intro}</p>}
    </header>
    <slot />
    <div class="share">
      <a class="btn" href={`https://wa.me/?text=${encodeURIComponent(share)}`}><Icon name="share" />Share on WhatsApp</a>
      <a class="btn" href={`https://wa.me/${site.reportWhatsApp}?text=${encodeURIComponent(`Something is wrong on ${site.url}${path}: `)}`}><Icon name="flag" />Report a mistake</a>
    </div>
    <Credits />
  </main>
</Layout>

<style>
  .page { max-width: 640px; margin: 0 auto; padding: max(12px, env(safe-area-inset-top)) 16px 0; }
  .back { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--muted); text-decoration: none; font-size: 16px; }
  .back :global(svg) { width: 18px; height: 18px; }
  .sign { margin-top: 10px; border-top: 10px solid var(--cat); border-radius: 4px 4px 0 0; padding-top: 14px; }
  h1 { font-size: clamp(38px, 11vw, 56px); margin: 0; }
  .hi { margin: 6px 0 0; color: var(--muted); font: 400 19px/1.3 "Anek Devanagari", var(--font); }
  .intro { font-size: 18px; margin: 14px 0 0; max-width: 46ch; }
  .share { display: flex; gap: 8px; margin-top: 30px; }
  .share .btn { flex: 1; }

  /* Shared bits for guide content. */
  .page :global(h2) { font-size: 23px; font-weight: 700; line-height: 1.2; margin: 30px 0 8px; }
  .page :global(h3) { font-size: 18px; font-weight: 650; margin: 18px 0 4px; }
  .page :global(p) { max-width: 60ch; }
  .page :global(.muted) { color: var(--muted); }
  .page :global(.src) { font-size: 13.5px; color: var(--muted); }
  /* A list of facts or entries with a hairline between them. */
  .page :global(.rows) { list-style: none; margin: 8px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .page :global(.rows > li) { padding: 12px 0; border-bottom: 1px solid var(--line); }
</style>
