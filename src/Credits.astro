---
import { shops, site } from "./data";

const counts = new Map<string, number>();
for (const s of shops) if (s.by) counts.set(s.by, (counts.get(s.by) ?? 0) + 1);
const names = [...counts].sort((a, b) => b[1] - a[1]).map(([n]) => n);
const list = names.length > 8 ? [...names.slice(0, 8), "others"] : names;
const thanks = list.length > 1 ? `${list.slice(0, -1).join(", ")} and ${list.at(-1)}` : list[0];
---
<footer class="credits">
  <p>
    A free guide to Mullana, made by <a href="https://abhibansal.dev">Abhinav Bansal</a>. Phone numbers are shown
    only with the owner's consent. Know a shop that's missing? <a href={site.addFormUrl}>Add a shop</a>. Something wrong? <a href={`https://wa.me/${site.reportWhatsApp}`}>Tell us on WhatsApp</a>.
  </p>
  {names.length > 0 && <p>Listings added by {thanks}.</p>}
  <p class="small">
    Map © <a href="https://openfreemap.org">OpenFreeMap</a>{", "}<a href="https://www.openmaptiles.org/">OpenMapTiles</a>{", data © "}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>.
    Buildings from <a href="https://overturemaps.org">Overture Maps Foundation</a>, including Google Open Buildings
    (CDLA-Permissive-2.0) and Microsoft (ODbL). Unchecked places from Overture Maps places (Meta and Microsoft,
    CDLA-Permissive-2.0; Foursquare, Apache-2.0) and OpenStreetMap (ODbL). Weather and air from <a href="https://open-meteo.com">Open-Meteo</a> (CC BY 4.0). <a href="https://github.com/abhibansal60/explore-mullana">Source code</a>.
  </p>
</footer>

<style>
  .credits { color: var(--muted); font-size: 14px; padding: 28px 0 40px; }
  .credits p { margin: 0 0 10px; max-width: 60ch; }
  .small { font-size: 12.5px; }
</style>
