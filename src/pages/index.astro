---
import Layout from "../Layout.astro";
import ShopCard from "../ShopCard.astro";
import PlaceRow from "../PlaceRow.astro";
import Credits from "../Credits.astro";
import Icon from "../Icon.astro";
import { categories, events, guide, kinds, places, shops, site, time12 } from "../data";

const all = [...shops, ...places];
const count = (k: string) => all.filter((s) => s.category === k).length;
// Only categories with places, biggest first.
const used = Object.keys(categories).filter((k) => count(k) > 0).sort((a, b) => count(b) - count(a));
const whenSort = [...events].sort((a, b) => (a.date + (a.time ?? "")).localeCompare(b.date + (b.time ?? "")));
const spot = (slug?: string) => all.find((s) => s.slug === slug);
const points = all.map((s) => ({
  slug: s.slug, name: s.name, color: categories[s.category].color, lat: s.lat, lng: s.lng, v: "phones" in s ? 1 : 0,
}));
---
<Layout title="Explore Mullana" description="Shops, food and places in Mullana and around MMDU, with opening hours, call, WhatsApp and directions.">
  <div class="app" id="app">
    <main class="feed">
      <header class="top">
        <button class="stone" id="home" aria-label="Back to the start">
          <span class="dome"><span class="hi" lang="hi">मुलाना</span><span class="en">Mullana</span></span>
          <span class="face"><span class="km" id="wx-t">0</span><span class="unit" id="wx-unit">km</span></span>
        </button>
        <div class="day" id="today">
          <p class="date" id="today-date"></p>
          <p class="pc"><b lang="hi" id="pc-hi"></b> <span id="pc-en"></span></p>
          <p class="wx" id="wx" hidden><b id="wx-sky"></b><span id="wx-more"></span><span id="wx-air"></span></p>
          <p class="count"><span id="stone-n">{all.length} places</span> <span id="stone-open" class="open"></span></p>
        </div>
      </header>

      <div class="find">
        <label class="search">
          <Icon name="search" />
          <input id="q" type="search" placeholder="Try chai, xerox, दवाई, 112" aria-label="Search Mullana" autocomplete="off" />
        </label>
        <div class="cats" role="group" aria-label="Filters">
          <button class="tog" id="open-now" aria-pressed="false"><Icon name="clock" />Open now</button>
          <button class="tog" id="near-me" aria-pressed="false"><Icon name="locate" /><span>Near me</span></button>
          <button class="tog map-tog" id="map-open"><Icon name="map" />Map</button>
        </div>
      </div>

      <div id="home-view">
        <section aria-labelledby="soon-h">
          <h2 class="grid-h" id="soon-h">Coming up</h2>
          <p class="pc-next muted" id="pc-next"></p>
          <div class="tcards">
            {whenSort.map((ev) => {
              const k = kinds[ev.kind];
              const at = spot(ev.slug);
              return (
                <article class="tcard" style={`--cat:${k.color}`} data-date={ev.date} data-end={ev.endDate ?? ev.date} data-time={ev.time} data-time-label={ev.time ? time12(ev.time) : undefined} hidden>
                  <p class="twhen"></p>
                  <h3 class="board">{ev.title}</h3>
                  {ev.titleHi && <p class="thi" lang="hi">{ev.titleHi}</p>}
                  <p class="tplace">{[k.name, ev.place].filter(Boolean).join(", ")}{ev.sample && " (sample)"}</p>
                  {ev.by && <p class="tplace">Added by {ev.by}</p>}
                  <div class="tlinks">
                    {at && <button class="btn tmap" data-pin={at.slug} data-lat={at.lat} data-lng={at.lng}><Icon name="map" />On the map</button>}
                    {ev.source && <a class="tsrc" href={ev.source.url} target="_blank" rel="noopener">Source</a>}
                  </div>
                </article>
              );
            })}
          </div>
          <div class="tfoot">
            <a class="btn" id="tshare" href="#"><Icon name="share" />Share today on WhatsApp</a>
            <a class="tlink" href="/festivals/">All festivals this year</a>
            <a class="tlink" href={site.addEventUrl || `https://wa.me/${site.reportWhatsApp}?text=${encodeURIComponent("Event for Explore Mullana: ")}`} target="_blank" rel="noopener">Tell us about an event</a>
          </div>
        </section>

        <h2 class="grid-h">What do you need?</h2>
        <nav class="tiles" aria-label="Categories">
          {used.map((k) => (
            <a class="tile" href={`#${k}`} data-cat={k} style={`--cat:${categories[k].color}`}>
              <span class="en">{categories[k].en}</span>
              <span class="hi" lang="hi">{categories[k].hi}</span>
              <span class="meta"><span>{count(k)} {count(k) === 1 ? "place" : "places"}</span><span class="tile-open"></span></span>
            </a>
          ))}
        </nav>

        <h2 class="grid-h">Know Mullana</h2>
        <nav class="signs" aria-label="Guide">
          {guide.map(({ slug, en, hi, what }) => (
            <a class:list={["sign", { alarm: slug === "helplines" }]} href={`/${slug}/`}>
              <span class="en board">{en}</span>
              <span class="hi" lang="hi">{hi}</span>
              <span class="what">{what}</span>
            </a>
          ))}
        </nav>

        <div class="addcard">
          <p>Know a shop that's missing? Add it in a minute. Only add numbers the owner agreed to share.</p>
          <a class="btn primary" href={site.addFormUrl} target="_blank" rel="noopener">Add a shop</a>
        </div>
      </div>

      <div id="list-view" hidden>
        <div class="lhead">
          <a class="back" id="back" href="/"><Icon name="back" />Everything</a>
          <div class="ltitle"><h2 id="l-title"></h2><span id="l-count" class="muted"></span></div>
        </div>
        <div id="gmatch">
          {guide.map((g) => (
            <a class="gm" href={`/${g.slug}/`} data-search={`${g.en} ${g.hi} ${g.what} ${g.keys}`.toLowerCase()} style={`--cat:${g.color}`} hidden>
              <b>{g.en}</b><span>{g.what}</span>
            </a>
          ))}
        </div>
        <div id="list" class="group">
          {shops.map((shop) => <ShopCard shop={shop} />)}
        </div>
        <h3 id="more-h" class="more-h">More around Mullana<span>Found on open map data. Not yet checked with the owner, so no phone numbers.</span></h3>
        <div id="more" class="group">
          {places.map((place) => <PlaceRow place={place} />)}
        </div>
        <p id="empty" class="empty" hidden>Nothing matches that yet. Try a shorter word, or clear the filters.</p>
      </div>
      <Credits />
    </main>

    <div class="stage" id="stage">
      <div id="map" data-points={JSON.stringify(points)}></div>
      <button class="btn map-btn map-close" id="map-close"><Icon name="close" />Close map</button>
      <button id="three" class="btn map-btn" hidden><Icon name="cube" /><span>3D</span></button>
    </div>
  </div>
</Layout>

<style>
  .feed { padding: 0 16px; max-width: 640px; }

  /* The one flourish: the town's kilometre stone. Today's temperature sits where the distance would. */
  .top { display: grid; grid-template-columns: 118px 1fr; gap: 16px; align-items: end; padding: max(18px, env(safe-area-inset-top)) 0 18px; }
  .stone {
    display: flex; flex-direction: column; width: 118px; padding: 0; border: 0; cursor: pointer; font: inherit; text-align: center;
    background: #fff; color: #1f1f1c; border-radius: 59px 59px 6px 6px; overflow: hidden;
    box-shadow: inset 0 0 0 1.5px #1f1f1c22, 0 10px 0 -4px var(--line);
  }
  .dome { display: flex; flex-direction: column; justify-content: flex-end; height: 74px; padding-bottom: 6px; background: var(--stone); }
  .stone .hi { font: 700 22px/1.05 "Anek Devanagari Variable", var(--font); }
  .stone .en { font-weight: 750; font-size: 15px; font-variation-settings: "wdth" 80; line-height: 1.1; }
  .face { display: flex; align-items: baseline; justify-content: center; gap: 3px; padding: 10px 0 12px; background: #fff; }
  .km { font-weight: 750; font-variation-settings: "wdth" 72; font-size: 46px; line-height: 0.9; }
  .unit { font-weight: 650; font-size: 15px; color: #62625b; }
  .day { padding-bottom: 4px; min-width: 0; }
  .day p { margin: 0; }
  .date { font-weight: 700; font-size: 19px; line-height: 1.2; }
  .pc { margin-top: 4px !important; font-size: 15px; }
  .pc b { font: 600 16px "Anek Devanagari Variable", var(--font); }
  .wx { margin-top: 4px !important; font-size: 14.5px; color: var(--muted); line-height: 1.35; }
  .wx b, .wx span { display: block; }
  .wx b { color: var(--ink); font-weight: 600; }
  .count { margin-top: 6px !important; font-size: 14px; color: var(--muted); }
  .count .open { color: var(--open); font-weight: 600; }

  .find { position: sticky; top: 0; z-index: 5; margin: 0 -16px; padding: 8px 16px 10px; background: var(--paper); }
  .search {
    display: flex; align-items: center; gap: 10px; padding: 0 14px; height: 52px;
    border: 2px solid var(--ink); border-radius: 8px; background: var(--sheet); color: var(--muted);
  }
  .search :global(svg) { width: 20px; height: 20px; flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--ink); font: 400 17px var(--font); }
  .search:focus-within { outline: 2px solid var(--focus); outline-offset: 2px; }
  .cats { display: flex; gap: 8px; margin-top: 10px; }
  .tog {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 40px; padding: 0 10px;
    border: 1px solid var(--line); border-radius: 6px; background: var(--sheet); color: var(--ink);
    font: 600 15px var(--font); cursor: pointer; white-space: nowrap;
  }
  .tog :global(svg) { width: 17px; height: 17px; flex: none; }
  .tog[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .grid-h { font-size: 22px; font-weight: 700; margin: 26px 0 10px; line-height: 1.2; }
  .muted { color: var(--muted); font-size: 14px; }
  .pc-next { margin: -6px 0 12px; }

  .tcards {
    display: flex; gap: 10px; margin: 0 -16px; padding: 0 16px 4px; overflow-x: auto;
    scroll-snap-type: x mandatory; scroll-padding-left: 16px; scrollbar-width: none;
  }
  .tcards::-webkit-scrollbar { display: none; }
  /* A notice pinned to the board: a strip of its kind's colour across the top. */
  .tcard {
    flex: none; width: 74%; scroll-snap-align: start; display: flex; flex-direction: column; gap: 3px;
    padding: 12px 14px 14px; border-radius: 6px; background: var(--sheet); border-top: 6px solid var(--cat);
    box-shadow: 0 0 0 1px var(--line);
  }
  .tcard p { margin: 0; }
  .twhen { font-size: 15px; font-weight: 700; color: var(--cat); }
  .tcard h3 { margin: 2px 0 0; font-size: 24px; overflow-wrap: anywhere; }
  .thi { font: 400 15px/1.3 "Anek Devanagari Variable", var(--font); color: var(--muted); }
  .tplace { font-size: 14px; color: var(--muted); }
  .tlinks { display: flex; align-items: center; gap: 16px; margin-top: auto; padding-top: 10px; }
  .tmap { min-height: 40px; font-size: 14.5px; }
  .tsrc { display: inline-flex; align-items: center; min-height: 40px; font-weight: 600; font-size: 14.5px; }
  .tfoot { display: flex; flex-wrap: wrap; align-items: center; column-gap: 18px; row-gap: 4px; margin-top: 12px; }
  .tfoot .btn { margin-right: auto; }
  .tlink { display: inline-flex; align-items: center; min-height: 40px; font-size: 14.5px; font-weight: 600; }

  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tile {
    display: flex; flex-direction: column; justify-content: center; gap: 1px; min-height: 76px; padding: 10px 12px 10px 15px;
    border-radius: 6px; background: var(--sheet); color: var(--ink); text-decoration: none;
    box-shadow: inset 5px 0 0 var(--cat), 0 0 0 1px var(--line);
  }
  .tile:active { transform: translateY(1px); }
  .tile .en { font-weight: 650; font-size: 16px; line-height: 1.25; }
  .tile .hi { color: var(--muted); font: 400 14px/1.3 "Anek Devanagari Variable", var(--font); }
  .tile .meta { color: var(--muted); font-size: 13.5px; }

  /* Guide pages as National Highway direction boards: white on green, with the inset white rule. */
  .signs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .sign {
    display: flex; flex-direction: column; gap: 2px; padding: 14px 14px 13px; border-radius: 6px; text-decoration: none;
    background: var(--sign); color: #fff; outline: 2px solid #fff; outline-offset: -6px;
  }
  .sign.alarm { background: var(--alarm); }
  .sign:active { transform: translateY(1px); }
  .sign:focus-visible { outline-color: var(--stone); }
  .sign .en { font-size: 22px; }
  .sign .hi { font: 500 15px/1.25 "Anek Devanagari Variable", var(--font); opacity: 0.92; }
  .sign .what { font-size: 13.5px; line-height: 1.3; opacity: 0.85; margin-top: 4px; }

  .gm { position: relative; display: flex; flex-direction: column; margin: 8px 0; padding: 12px 14px 12px 18px; border-radius: 6px; text-decoration: none; background: var(--sheet); box-shadow: inset 5px 0 0 var(--cat), 0 0 0 1px var(--line); }
  .gm b { font-weight: 650; }
  .gm span { color: var(--muted); font-size: 14.5px; }
  .addcard { margin: 26px 0 8px; padding: 16px; border-radius: 6px; background: var(--sheet); box-shadow: 0 0 0 1px var(--line); }
  .addcard p { margin: 0 0 12px; max-width: 46ch; }

  .lhead { margin: 10px 0 4px; }
  .back { display: inline-flex; align-items: center; gap: 4px; min-height: 40px; font-weight: 600; font-size: 15px; }
  .back :global(svg) { width: 18px; height: 18px; }
  .ltitle { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .ltitle h2 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; }
  .ltitle :global([lang="hi"]) { font: 400 17px "Anek Devanagari Variable", var(--font); color: var(--muted); margin-left: 8px; }
  .ltitle .muted { white-space: nowrap; }
  .empty { color: var(--muted); padding: 24px 0; }
  .more-h { font-size: 20px; font-weight: 700; margin: 20px 0 4px; }
  .more-h span { display: block; font-size: 14px; font-weight: 400; color: var(--muted); margin-top: 2px; }

  /* Phones: the map is a full-screen layer, opened on demand and only then downloaded. */
  .stage { position: fixed; inset: 0; z-index: 20; background: var(--paper); visibility: hidden; }
  .app.map-on .stage { visibility: visible; }
  #map { position: absolute; inset: 0; background: var(--line); }
  .map-btn { position: absolute; right: 12px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 2; box-shadow: 0 4px 14px rgb(0 0 0 / 0.14); }
  .map-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .map-close { left: 12px; right: auto; top: max(12px, env(safe-area-inset-top)); bottom: auto; }
  #three { bottom: max(16px, env(safe-area-inset-bottom)); }

  @media (min-width: 560px) { .tiles, .signs { grid-template-columns: repeat(3, minmax(0, 1fr)); } .tcard { width: 260px; } }
  /* Wide screens: the page on the left, the map always beside it. */
  @media (min-width: 900px) {
    .app { display: grid; grid-template-columns: minmax(480px, 600px) 1fr; }
    .feed { max-width: none; padding: 0 24px; }
    .find { margin: 0 -24px; padding: 8px 24px 10px; }
    .stage { position: sticky; top: 0; height: 100svh; visibility: visible; z-index: 0; }
    .map-tog, .map-close { display: none; }
    .tcards { margin: 0 -24px; padding: 0 24px 4px; scroll-padding-left: 24px; }
  }
  #list-view.in-cat :global(.catname) { display: none; }
</style>

<script>
  import { isOpen, istDate, markOpenBadges, time12 } from "../open";
  import { distLabel, metres } from "../geo";
  import { airBand, loadWeather } from "../weather";
  import { panchang, tithiName } from "../panchang";
  import { filterMap, initMap, set3D, showMe, showPin, showTown } from "../map";

  markOpenBadges();
  const $ = (id: string) => document.getElementById(id)!;

  // Today in Mullana: all dates in IST. Past events hide.
  // Runs again when the app comes back to the front, so an app left open overnight moves on to the new day.
  function renderToday() {
    const ist = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleString("en-IN", { timeZone: "Asia/Kolkata", ...o });
    const now = new Date();
    const today = istDate(now);
    const day = (s: string) => Date.parse(s + "T00:00:00Z") / 864e5;
    const hhmm = ist(now, { hour: "2-digit", minute: "2-digit", hour12: false }).replace(/^24/, "00");
    let shown = 0;
    document.querySelectorAll<HTMLElement>(".tcard").forEach((c) => {
      const { date, end, time, timeLabel } = c.dataset;
      // A timed event stays up for two hours after it starts.
      const [h, m] = (time ?? "23:59").split(":").map(Number);
      const cutoff = `${String(Math.min(h + 2, 23)).padStart(2, "0")}:${h + 2 > 23 ? "59" : String(m).padStart(2, "0")}`;
      const past = end! < today || (end! === today && date === end && hhmm > cutoff);
      // The next two weeks only; the festivals page has the rest of the year.
      const n = Math.max(0, day(date!) - day(today));
      c.hidden = past || n > 14 || shown >= 6;
      if (c.hidden) return;
      shown++;
      const at = timeLabel ? `, ${timeLabel}` : "";
      const d = new Date(Date.parse(date! + "T06:00:00Z"));
      const label = n === 0 ? (date! < today ? "On now" : "Today") : n === 1 ? "Tomorrow" : n < 7 ? ist(d, { weekday: "long" }) : ist(d, { weekday: "short", day: "numeric", month: "short" }).replace(",", "");
      c.querySelector(".twhen")!.textContent = label + at;
    });
    // Tithi for the day: the section always has this, so it never hides.
    const p = panchang(today);
    const t = tithiName(p.tithi);
    $("pc-hi").textContent = t.hi;
    $("pc-en").textContent = t.en;
    const short = (s: string) => ist(new Date(Date.parse(s + "T06:00:00Z")), { weekday: "short", day: "numeric", month: "short" }).replace(",", "");
    const coming = ([["Ekadashi", p.ekadashi], ["Amavasya", p.amavasya], ["Purnima", p.purnima]] as [string, string | undefined][])
      .filter((x): x is [string, string] => !!x[1])
      .sort((a, b) => a[1].localeCompare(b[1]))
      .map(([n, d]) => `${n} ${short(d)}`);
    $("pc-next").textContent = `Next: ${coming.join(", ")}`;
    const share = () => {
      const lines = [`Today in Mullana, ${$("today-date").textContent}`];
      if (!$("wx").hidden) lines.push(`${$("wx-t").textContent} ${$("wx-sky").textContent}. ${$("wx-air").textContent}`.trim());
      lines.push(`${t.hi} (${t.en})`);
      const next = [...document.querySelectorAll<HTMLElement>(".tcard:not([hidden])")].slice(0, 3)
        .map((c) => `${c.querySelector("h3")!.textContent} ${c.querySelector(".twhen")!.textContent}`);
      if (next.length) lines.push(`Coming up: ${next.join("; ")}`);
      lines.push(location.origin + "/");
      ($("tshare") as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(lines.join("\n"))}`;
    };
    $("today").hidden = false;
    loadWeather()
      .then((w) => {
        $("wx-t").textContent = `${w.temp}°`;
        $("wx-unit").textContent = "";
        $("wx-sky").textContent = w.rain ? `${w.sky}, rain likely around ${time12(w.rain)}` : w.sky;
        $("wx-more").textContent = `High ${w.max}°, low ${w.min}°. Sunrise ${time12(w.sunrise)}, sunset ${time12(w.sunset)}`;
        if (w.pm25 != null) $("wx-air").textContent = `Air ${airBand(w.pm25).toLowerCase()}, PM2.5 ${w.pm25}`;
        $("wx").hidden = false;
        share();
      })
      .catch(() => {});
    $("today-date").textContent = ist(now, { weekday: "long", day: "numeric", month: "long" }).replace(",", "");
    share();
  }
  renderToday();
  document.addEventListener("visibilitychange", () => document.visibilityState === "visible" && renderToday());
  const q = $("q") as HTMLInputElement;
  const moreH = $("more-h");
  const rows = [...document.querySelectorAll<HTMLElement>(".row")];
  const order = new Map(rows.map((r, i) => [r, i]));
  const empty = $("empty");
  const stoneN = $("stone-n");
  const stoneOpen = $("stone-open");
  const openBtn = $("open-now") as HTMLButtonElement;
  const nearBtn = $("near-me") as HTMLButtonElement;
  const nearLabel = nearBtn.querySelector("span")!;
  const homeView = $("home-view");
  const listView = $("list-view");
  // Category names come from the tiles, so the client never imports the data module.
  const categories: Record<string, { en: string; hi: string }> = {};
  document.querySelectorAll<HTMLElement>(".tile").forEach((t) => {
    categories[t.dataset.cat!] = { en: t.querySelector(".en")!.textContent!, hi: t.querySelector(".hi")!.textContent! };
  });
  let cat = "";
  let openOnly = false;
  let me: [number, number] | undefined;
  let map: Awaited<ReturnType<typeof initMap>> | undefined;
  let inList = false;

  // Unchecked places have no hours, so they never count as open.
  const rowOpen = (r: HTMLElement) => {
    const b = r.querySelector<HTMLElement>(".open-badge");
    return !!b && isOpen(b.dataset.open!, b.dataset.close!);
  };

  // Open counts on the category tiles.
  document.querySelectorAll<HTMLElement>(".tile").forEach((t) => {
    const n = rows.filter((r) => r.dataset.cat === t.dataset.cat && rowOpen(r)).length;
    if (n) t.querySelector(".tile-open")!.textContent = `, ${n} open now`;
  });

  function apply() {
    const term = q.value.trim();
    const terms = term.toLowerCase().split(/\s+/).filter(Boolean);
    const visible: string[] = [];
    let openCount = 0;
    for (const r of rows) {
      const open = rowOpen(r);
      const show =
        (!cat || r.dataset.cat === cat) && (!openOnly || open) && terms.every((t) => r.dataset.search!.includes(t));
      r.hidden = !show;
      if (show) {
        visible.push(r.dataset.slug!);
        if (open) openCount++;
      }
    }
    // Guide pages answer searches like "train" or "112" that no shop does.
    let guideHits = 0;
    document.querySelectorAll<HTMLElement>(".gm").forEach((g) => {
      const words = g.dataset.search!.split(/\s+/);
      g.hidden = term.length < 2 || !terms.every((t) => words.some((w) => w.startsWith(t)));
      if (!g.hidden) guideHits++;
    });
    empty.hidden = visible.length > 0 || guideHits > 0;
    moreH.hidden = !rows.some((r) => r.classList.contains("place") && !r.hidden);
    stoneN.textContent = `${visible.length} ${visible.length === 1 ? "place" : "places"}`;
    stoneOpen.textContent = openCount ? `${openCount} open now` : "";
    if (map) filterMap(map, visible);

    // Grid until there is a category, a search or a filter; then the list.
    const list = !!(cat || term || openOnly || me);
    homeView.hidden = list;
    listView.hidden = !list;
    // Inside one category its name on every row is noise.
    listView.classList.toggle("in-cat", !!cat);
    if (list) {
      const c = categories[cat];
      const title = $("l-title");
      title.textContent = term ? `Results for “${term}”` : c ? c.en : openOnly ? "Open now" : "Nearest first";
      if (!term && c) {
        const hi = document.createElement("span");
        hi.lang = "hi";
        hi.textContent = c.hi;
        title.append(hi);
      }
      $("l-count").textContent = `${visible.length} ${visible.length === 1 ? "place" : "places"}`;
    }
    if (list !== inList) {
      inList = list;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  }

  function sortByDistance() {
    const d = me ? new Map(rows.map((r) => [r, metres(me!, [+r.dataset.lat!, +r.dataset.lng!])])) : undefined;
    for (const r of rows) {
      const el = r.querySelector<HTMLElement>(".dist")!;
      el.textContent = d ? distLabel(d.get(r)!) : "";
      el.hidden = !d;
    }
    [...rows].sort((a, b) => (d ? d.get(a)! - d.get(b)! : order.get(a)! - order.get(b)!)).forEach((r) => r.parentElement!.append(r));
  }

  function setNear(on: boolean) {
    nearBtn.setAttribute("aria-pressed", String(on));
    nearLabel.textContent = on ? "Nearest first" : "Near me";
    if (!on) me = undefined;
    sortByDistance();
    apply();
  }

  // The hash is the category: #food opens it, no hash is the grid.
  function fromHash() {
    const h = location.hash.slice(1);
    cat = Object.hasOwn(categories, h) ? h : "";
    apply();
  }
  addEventListener("hashchange", fromHash);
  // Also drops ?q=, so a reload after reset doesn't bring an old search back.
  const clearHash = () => history.pushState(null, "", location.pathname);

  q.addEventListener("input", apply);
  openBtn.addEventListener("click", () => {
    openOnly = !openOnly;
    openBtn.setAttribute("aria-pressed", String(openOnly));
    apply();
  });
  nearBtn.addEventListener("click", () => {
    if (me) return setNear(false);
    nearLabel.textContent = "Finding you…";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        me = [pos.coords.latitude, pos.coords.longitude];
        setNear(true);
        if (map) showMe(map, me[1], me[0]);
      },
      () => (nearLabel.textContent = "Location is off"),
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  // Reset everything back to the grid. The stone also looks at the whole town again.
  function reset() {
    q.value = "";
    cat = "";
    openOnly = false;
    openBtn.setAttribute("aria-pressed", "false");
    rows.forEach((r) => r.classList.remove("picked"));
    if (location.hash || location.search) clearHash();
    setNear(false);
  }
  $("back").addEventListener("click", (e) => {
    e.preventDefault();
    reset();
  });
  $("home").addEventListener("click", () => {
    reset();
    window.scrollTo({ top: 0, behavior: "smooth" });
    if (map) showTown(map);
  });

  // /?q=sim opens with that search, so guide pages can link straight to a search.
  q.value = new URLSearchParams(location.search).get("q") ?? "";
  fromHash();

  // Tapping a pin closes the map (on phones) and opens that place's row.
  function pick(slug: string) {
    const row = document.querySelector<HTMLElement>(`.row[data-slug="${slug}"]`);
    if (!row) return;
    const fromMap = app.classList.contains("map-on");
    app.classList.remove("map-on");
    // From the grid, open the pin's category first so its row exists on screen.
    // The map's own history entry is replaced, so Back goes where it did before the map.
    if (listView.hidden) {
      cat = row.dataset.cat!;
      history[fromMap ? "replaceState" : "pushState"](null, "", `#${cat}`);
      apply();
    } else if (fromMap) history.replaceState(null, "", location.href);
    rows.forEach((r) => r.classList.toggle("picked", r === row));
    row.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // The map downloads only when first needed: always on wide screens, on phones when opened.
  const app = $("app");
  const el = $("map");
  const wide = matchMedia("(min-width: 900px)");
  let loading: Promise<Awaited<ReturnType<typeof initMap>> | undefined> | undefined;
  function ensureMap() {
    loading ??= initMap(el, JSON.parse(el.dataset.points!), pick)
      .then((m) => {
        map = m;
        m.on("load", apply);
        // 3D pulls ~1 MB of buildings, so only offer it on phones that can take it.
        const mem = (navigator as any).deviceMemory;
        const three = $("three") as HTMLButtonElement;
        if (!mem || mem >= 3) {
          three.hidden = false;
          three.setAttribute("aria-pressed", "false");
          three.addEventListener("click", () => {
            const on = three.getAttribute("aria-pressed") !== "true";
            set3D(m, on);
            three.setAttribute("aria-pressed", String(on));
            three.querySelector("span")!.textContent = on ? "2D" : "3D";
          });
        }
        return m;
      })
      .catch((e) => {
        console.error(e);
        el.innerHTML = '<p style="padding:90px 20px 0;color:var(--muted)">The map needs a newer browser. Every place is in the list.</p>';
        return undefined;
      });
    return loading;
  }
  // Opening the map adds a history entry, so the phone's Back button closes it.
  function openMap() {
    if (wide.matches) return ensureMap();
    if (!app.classList.contains("map-on")) {
      app.classList.add("map-on");
      history.pushState({ map: 1 }, "", location.href);
    }
    return ensureMap().then((m) => (m?.resize(), m));
  }
  const closeMap = () => history.state?.map ? history.back() : app.classList.remove("map-on");
  addEventListener("popstate", () => !history.state?.map && app.classList.remove("map-on"));
  $("map-open").addEventListener("click", () => openMap());
  $("map-close").addEventListener("click", closeMap);
  addEventListener("keydown", (e) => e.key === "Escape" && app.classList.contains("map-on") && closeMap());
  if (wide.matches) ensureMap();
  wide.addEventListener("change", (e) => e.matches && ensureMap());

  document.querySelectorAll<HTMLElement>(".tmap").forEach((b) =>
    b.addEventListener("click", async () => {
      const m = await openMap();
      const at = () => showPin(m!, b.dataset.pin!, +b.dataset.lng!, +b.dataset.lat!);
      if (!m) pick(b.dataset.pin!);
      else if (!at()) m.once("load", at);
    }),
  );
</script>
