---
import Layout from "../Layout.astro";
import ShopCard from "../ShopCard.astro";
import PlaceRow from "../PlaceRow.astro";
import Credits from "../Credits.astro";
import Icon from "../Icon.astro";
import { categories, events, guide, kinds, places, shops, site, time12 } from "../data";

const all = [...shops, ...places];
const count = (k: string) => all.filter((s) => s.category === k).length;
// Only categories with places, biggest first.
const used = Object.keys(categories).filter((k) => count(k) > 0).sort((a, b) => count(b) - count(a));
const whenSort = [...events].sort((a, b) => (a.date + (a.time ?? "")).localeCompare(b.date + (b.time ?? "")));
const spot = (slug?: string) => all.find((s) => s.slug === slug);
const points = all.map((s) => ({
  slug: s.slug, name: s.name, color: categories[s.category].color, lat: s.lat, lng: s.lng, v: "phones" in s ? 1 : 0,
}));
---
<Layout title="Explore Mullana" description="Shops, food and places in Mullana and around MMDU, with opening hours, call, WhatsApp and directions.">
  <div class="app">
    <div class="stage">
      <div id="map" data-points={JSON.stringify(points)}></div>
      <button class="stone" id="home" aria-label="Show all of Mullana">
        <span class="dome"></span>
        <span class="hi" lang="hi">मुलाना</span>
        <span class="en">Mullana</span>
        <span class="n" id="stone-n">{all.length} places</span>
        <span class="n open" id="stone-open"></span>
      </button>
      <button id="three" class="btn map-btn" hidden><Icon name="cube" /><span>3D</span></button>
    </div>

    <section class="sheet" aria-label="Places">
      <div class="grip" aria-hidden="true"></div>
      <section class="today" id="today" aria-labelledby="today-h" hidden>
        <h2 id="today-h" class="grid-h">Today in Mullana <span id="today-date" class="muted"></span></h2>
        <div class="wx" id="wx" hidden>
          <span class="wt" id="wx-t"></span>
          <span class="wd"><b id="wx-sky"></b><span id="wx-more"></span><span id="wx-air"></span></span>
        </div>
        <div class="tcards">
          {whenSort.map((ev) => {
            const k = kinds[ev.kind];
            const at = spot(ev.slug);
            return (
              <article class="tcard" data-date={ev.date} data-end={ev.endDate ?? ev.date} data-time={ev.time} data-time-label={ev.time ? time12(ev.time) : undefined} hidden>
                <div class="tmeta">
                  <span class="tkind"><i style={`background:${k.color}`}></i>{k.name}</span>
                  {ev.sample && <span class="tsample">Sample</span>}
                </div>
                <p class="twhen"></p>
                <h3 class="board">{ev.title}</h3>
                {ev.titleHi && <p class="thi" lang="hi">{ev.titleHi}</p>}
                {ev.place && <p class="tplace">{ev.place}</p>}
                {ev.by && <p class="tplace">Added by {ev.by}</p>}
                <div class="tlinks">
                  {at && <button class="btn tmap" data-pin={at.slug} data-lat={at.lat} data-lng={at.lng}>Show on map</button>}
                  {ev.source && <a class="tsrc" href={ev.source.url} target="_blank" rel="noopener">Source</a>}
                </div>
              </article>
            );
          })}
        </div>
        <p class="tadd"><a href="/festivals/">All festivals and melas this year</a><br /><a href={site.addEventUrl || `https://wa.me/${site.reportWhatsApp}?text=${encodeURIComponent("Event for Explore Mullana: ")}`} target="_blank" rel="noopener">Something happening in Mullana? Tell us</a></p>
      </section>
      <label class="search">
        <Icon name="search" />
        <input id="q" type="search" placeholder="Try chai, xerox, दवाई" aria-label="Search places" autocomplete="off" />
      </label>
      <div class="cats" role="group" aria-label="Filters">
        <button class="tog" id="open-now" aria-pressed="false"><Icon name="clock" />Open now</button>
        <button class="tog" id="near-me" aria-pressed="false"><Icon name="locate" /><span>Near me</span></button>
      </div>

      <div id="home-view">
        <h2 class="grid-h">What do you need?</h2>
        <nav class="tiles" aria-label="Categories">
          {used.map((k) => (
            <a class="tile" href={`#${k}`} data-cat={k} style={`--cat:${categories[k].color}`}>
              <span class="en"><i></i>{categories[k].en}</span>
              <span class="hi" lang="hi">{categories[k].hi}</span>
              <span class="meta"><span>{count(k)} {count(k) === 1 ? "place" : "places"}</span><span class="tile-open"></span></span>
            </a>
          ))}
        </nav>
        <h2 class="grid-h">Know Mullana</h2>
        <nav class="guide" aria-label="Guide">
          {guide.map(({ slug, en, hi, what }) => (
            <a href={`/${slug}/`}><span class="en">{en} <span lang="hi">{hi}</span></span><span class="what">{what}</span></a>
          ))}
        </nav>
        <div class="addcard">
          <p>Know a shop that's missing? Add it in a minute. Only add numbers the owner agreed to share.</p>
          <a class="btn primary" href={site.addFormUrl} target="_blank" rel="noopener">Add a shop</a>
        </div>
      </div>

      <div id="list-view" hidden>
        <div class="lhead">
          <a class="back" id="back" href="/"><Icon name="back" />All categories</a>
          <div class="ltitle"><h2 id="l-title"></h2><span id="l-count" class="muted"></span></div>
        </div>
        <div id="gmatch">
          {guide.map((g) => (
            <a class="gm" href={`/${g.slug}/`} data-search={`${g.en} ${g.hi} ${g.what} ${g.keys}`.toLowerCase()} style={`--cat:${g.color}`} hidden>
              <b>{g.en}</b><span>{g.what}</span>
            </a>
          ))}
        </div>
        <div id="list" class="group">
          {shops.map((shop) => <ShopCard shop={shop} />)}
        </div>
        <h3 id="more-h" class="more-h">More around Mullana<span>Found on open map data. Not yet checked with the owner, so no phone numbers.</span></h3>
        <div id="more" class="group">
          {places.map((place) => <PlaceRow place={place} />)}
        </div>
        <p id="empty" class="empty" hidden>Nothing matches that yet. Try a shorter word, or clear the filters.</p>
      </div>
      <Credits />
    </section>
  </div>
</Layout>

<style>
  .stage { position: sticky; top: 0; height: 42svh; z-index: 0; }
  #map { position: absolute; inset: 0; background: var(--line); }
  .sheet {
    position: relative; z-index: 1; margin-top: -28px; min-height: 60svh;
    background: var(--sheet); border-radius: 18px 18px 0 0; padding: 6px 16px 0;
    box-shadow: 0 -1px 0 var(--line), 0 -8px 24px rgb(0 0 0 / 0.06);
  }
  .grip { width: 40px; height: 4px; border-radius: 2px; background: var(--line); margin: 4px auto 12px; }

  /* The one flourish: a Haryana kilometre stone holding the town's name. */
  .stone {
    position: absolute; top: max(14px, env(safe-area-inset-top)); left: 14px; z-index: 2;
    width: 92px; padding: 0 0 8px; text-align: center; overflow: hidden; border: 0; cursor: pointer; font: inherit;
    background: #fff; color: #1c1b19; border-radius: 46px 46px 6px 6px;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.12), 0 6px 18px rgb(0 0 0 / 0.14);
  }
  .dome { display: block; height: 30px; background: var(--stone); margin-bottom: 6px; }
  .stone .hi { display: block; font: 700 17px/1.1 "Anek Devanagari", var(--font); }
  .stone .en { display: block; font-weight: 700; font-size: 15px; font-variation-settings: "wdth" 80; }
  .stone .n { display: block; font-size: 12.5px; color: #68645c; margin-top: 3px; }

  .map-btn { position: absolute; right: 12px; bottom: 44px; z-index: 2; box-shadow: 0 4px 14px rgb(0 0 0 / 0.14); }
  .map-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .search {
    display: flex; align-items: center; gap: 10px; padding: 0 14px; height: 50px;
    border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--muted);
  }
  .search :global(svg) { width: 20px; height: 20px; flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--ink); font: 400 17px var(--font); }
  .search:focus-within { border-color: var(--ink); }

  .cats { display: flex; gap: 8px; margin: 12px 0 4px; flex-wrap: wrap; }
  .tog {
    flex: none; display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px;
    border: 1px solid var(--ink); border-radius: 6px; background: var(--sheet); color: var(--ink);
    font: 600 15px var(--font); cursor: pointer;
  }
  .tog :global(svg) { width: 17px; height: 17px; }
  .tog[aria-pressed="true"] { background: var(--ink); color: var(--paper); }

  .today .grid-h { margin-top: 8px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .today .muted { font-size: 14px; font-weight: 400; white-space: normal; }
  .tcards {
    display: flex; gap: 10px; margin: 0 -16px; padding: 0 16px 4px; overflow-x: auto;
    scroll-snap-type: x mandatory; scroll-padding-left: 16px; scrollbar-width: none;
  }
  .tcards::-webkit-scrollbar { display: none; }
  .tcard {
    flex: none; width: 78%; scroll-snap-align: start; display: flex; flex-direction: column; gap: 4px;
    padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper);
  }
  .tmeta { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 14px; color: var(--muted); }
  .tkind { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); }
  .tkind i { width: 10px; height: 10px; border-radius: 3px; flex: none; }
  .tsample { padding: 1px 7px; border: 1px solid var(--muted); border-radius: 4px; font-size: 12.5px; line-height: 1.4; }
  .tcard p { margin: 0; }
  .twhen { font-size: 15px; font-weight: 600; margin-top: 6px !important; }
  .tcard h3 { margin: 0; font-size: 20px; overflow-wrap: anywhere; }
  .thi { font: 400 15px/1.3 "Anek Devanagari", var(--font); color: var(--muted); }
  .tplace { font-size: 14.5px; color: var(--muted); }
  .tlinks { display: flex; align-items: center; gap: 16px; margin-top: auto; padding-top: 10px; }
  .tmap { min-height: 40px; font-size: 14.5px; }
  .tsrc { display: inline-flex; align-items: center; min-height: 40px; font-weight: 600; font-size: 14.5px; text-underline-offset: 3px; }
  .wx { display: flex; align-items: center; gap: 14px; margin: 0 0 12px; }
  .wt { font-weight: 750; font-variation-settings: "wdth" 78; font-size: 44px; line-height: 1; }
  .wd { display: flex; flex-direction: column; font-size: 14.5px; color: var(--muted); line-height: 1.35; }
  .wd b { color: var(--ink); font-weight: 600; font-size: 15.5px; }
  .tadd { margin: 6px 0 0; font-size: 14px; color: var(--muted); }
  .tadd a { display: inline-block; padding: 6px 0; text-underline-offset: 3px; }

  .grid-h { font-size: 22px; font-weight: 700; margin: 18px 0 10px; line-height: 1.2; }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tile {
    display: flex; flex-direction: column; justify-content: center; gap: 1px; min-height: 72px; padding: 10px 12px;
    border: 1px solid var(--line); border-radius: 8px; background: var(--sheet); color: var(--ink); text-decoration: none;
  }
  .tile:active { transform: translateY(1px); }
  .tile .en { display: flex; align-items: center; gap: 8px; font-weight: 650; font-size: 16px; line-height: 1.25; }
  .tile i { flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--cat); }
  .tile .hi { color: var(--muted); font: 400 14px/1.3 "Anek Devanagari", var(--font); padding-left: 18px; }
  .tile .meta { color: var(--muted); font-size: 13.5px; padding-left: 18px; }
  .gm { position: relative; display: flex; flex-direction: column; margin: 8px 0; padding: 12px 14px 12px 18px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; background: var(--paper); }
  .gm::before { content: ""; position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; border-radius: 2px; background: var(--cat); }
  .gm b { font-weight: 650; }
  .gm span { color: var(--muted); font-size: 14.5px; }
  .guide { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .guide a { display: flex; flex-direction: column; gap: 1px; padding: 11px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .guide .en { font-weight: 650; font-size: 17px; }
  .guide [lang="hi"] { font: 400 15px "Anek Devanagari", var(--font); color: var(--muted); margin-left: 6px; }
  .guide .what { color: var(--muted); font-size: 14.5px; }
  .addcard { margin: 18px 0 8px; padding: 16px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
  .addcard p { margin: 0 0 12px; max-width: 46ch; }

  .lhead { margin: 14px 0 4px; }
  .back { display: inline-flex; align-items: center; gap: 4px; min-height: 40px; font-weight: 600; font-size: 15px; text-underline-offset: 3px; }
  .back :global(svg) { width: 18px; height: 18px; }
  .ltitle { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .ltitle h2 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; }
  .ltitle :global([lang="hi"]) { font: 400 17px "Anek Devanagari", var(--font); color: var(--muted); margin-left: 8px; }
  .muted { color: var(--muted); font-size: 14px; white-space: nowrap; }
  .stone .open { color: #1e7a3a; font-weight: 600; margin-top: 0; }
  .empty { color: var(--muted); padding: 24px 0; }
  .more-h { font-size: 20px; font-weight: 700; margin: 20px 0 4px; }
  .more-h span { display: block; font-size: 14px; font-weight: 400; color: var(--muted); margin-top: 2px; }

  @media (min-width: 560px) and (max-width: 899px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .app { display: grid; grid-template-columns: 420px 1fr; height: 100svh; }
    .stage { order: 2; position: relative; height: auto; }
    .sheet { order: 1; margin: 0; border-radius: 0; overflow-y: auto; box-shadow: 1px 0 0 var(--line); padding-top: 18px; }
    .grip { display: none; }
    .tcard { width: 260px; }
    .map-btn { bottom: 24px; }
  }
  #list-view.in-cat :global(.catname) { display: none; }
</style>

<script>
  import { isOpen, markOpenBadges, time12 } from "../open";
  import { distLabel, metres } from "../geo";
  import { airBand, loadWeather } from "../weather";
  import { filterMap, initMap, set3D, showMe, showPin, showTown } from "../map";

  markOpenBadges();
  const $ = (id: string) => document.getElementById(id)!;

  // Today in Mullana: all dates in IST. Past events hide, and no upcoming event hides the section.
  (() => {
    const ist = (d: Date, o: Intl.DateTimeFormatOptions) => d.toLocaleString("en-IN", { timeZone: "Asia/Kolkata", ...o });
    const now = new Date();
    const ymd = (d: Date) => ist(d, { year: "numeric", month: "2-digit", day: "2-digit" }).split("/").reverse().join("-");
    const today = ymd(now);
    const day = (s: string) => Date.parse(s + "T00:00:00Z") / 864e5;
    const hhmm = ist(now, { hour: "2-digit", minute: "2-digit", hour12: false }).replace(/^24/, "00");
    let shown = 0;
    document.querySelectorAll<HTMLElement>(".tcard").forEach((c) => {
      const { date, end, time, timeLabel } = c.dataset;
      // A timed event stays up for two hours after it starts.
      const [h, m] = (time ?? "23:59").split(":").map(Number);
      const cutoff = `${String(Math.min(h + 2, 23)).padStart(2, "0")}:${h + 2 > 23 ? "59" : String(m).padStart(2, "0")}`;
      const past = end! < today || (end! === today && date === end && hhmm > cutoff);
      // The next two weeks only; the festivals page has the rest of the year.
      const n = Math.max(0, day(date!) - day(today));
      c.hidden = past || n > 14 || shown >= 6;
      if (c.hidden) return;
      shown++;
      const at = timeLabel ? `, ${timeLabel}` : "";
      const d = new Date(Date.parse(date! + "T06:00:00Z"));
      const label = n === 0 ? (date! < today ? "On now" : "Today") : n === 1 ? "Tomorrow" : n < 7 ? ist(d, { weekday: "long" }) : ist(d, { weekday: "short", day: "numeric", month: "short" }).replace(",", "");
      c.querySelector(".twhen")!.textContent = label + at;
    });
    $("today").hidden = !shown;
    loadWeather()
      .then((w) => {
        $("wx-t").textContent = `${w.temp}°`;
        $("wx-sky").textContent = w.rain ? `${w.sky}, rain likely around ${time12(w.rain)}` : w.sky;
        $("wx-more").textContent = `High ${w.max}°, low ${w.min}°. Sunrise ${time12(w.sunrise)}, sunset ${time12(w.sunset)}`;
        if (w.pm25 != null) $("wx-air").textContent = `Air ${airBand(w.pm25).toLowerCase()}, PM2.5 ${w.pm25}`;
        $("wx").hidden = false;
        $("today").hidden = false;
      })
      .catch(() => {});
    $("today-date").textContent = ist(now, { weekday: "long", day: "numeric", month: "long" }).replace(",", "");
  })();
  const q = $("q") as HTMLInputElement;
  const moreH = $("more-h");
  const rows = [...document.querySelectorAll<HTMLElement>(".row")];
  const order = new Map(rows.map((r, i) => [r, i]));
  const empty = $("empty");
  const stoneN = $("stone-n");
  const stoneOpen = $("stone-open");
  const openBtn = $("open-now") as HTMLButtonElement;
  const nearBtn = $("near-me") as HTMLButtonElement;
  const nearLabel = nearBtn.querySelector("span")!;
  const homeView = $("home-view");
  const listView = $("list-view");
  const sheet = document.querySelector<HTMLElement>(".sheet")!;
  // Category names come from the tiles, so the client never imports the data module.
  const categories: Record<string, { en: string; hi: string }> = {};
  document.querySelectorAll<HTMLElement>(".tile").forEach((t) => {
    categories[t.dataset.cat!] = { en: t.querySelector(".en")!.textContent!, hi: t.querySelector(".hi")!.textContent! };
  });
  let cat = "";
  let openOnly = false;
  let me: [number, number] | undefined;
  let map: Awaited<ReturnType<typeof initMap>> | undefined;
  let inList = false;

  // Unchecked places have no hours, so they never count as open.
  const rowOpen = (r: HTMLElement) => {
    const b = r.querySelector<HTMLElement>(".open-badge");
    return !!b && isOpen(b.dataset.open!, b.dataset.close!);
  };

  // Open counts on the category tiles.
  document.querySelectorAll<HTMLElement>(".tile").forEach((t) => {
    const n = rows.filter((r) => r.dataset.cat === t.dataset.cat && rowOpen(r)).length;
    if (n) t.querySelector(".tile-open")!.textContent = `, ${n} open now`;
  });

  function apply() {
    const term = q.value.trim();
    const terms = term.toLowerCase().split(/\s+/).filter(Boolean);
    const visible: string[] = [];
    let openCount = 0;
    for (const r of rows) {
      const open = rowOpen(r);
      const show =
        (!cat || r.dataset.cat === cat) && (!openOnly || open) && terms.every((t) => r.dataset.search!.includes(t));
      r.hidden = !show;
      if (show) {
        visible.push(r.dataset.slug!);
        if (open) openCount++;
      }
    }
    // Guide pages answer searches like "train" or "112" that no shop does.
    let guideHits = 0;
    document.querySelectorAll<HTMLElement>(".gm").forEach((g) => {
      g.hidden = !terms.length || !terms.every((t) => g.dataset.search!.includes(t));
      if (!g.hidden) guideHits++;
    });
    empty.hidden = visible.length > 0 || guideHits > 0;
    moreH.hidden = !rows.some((r) => r.classList.contains("place") && !r.hidden);
    stoneN.textContent = `${visible.length} ${visible.length === 1 ? "place" : "places"}`;
    stoneOpen.textContent = openCount ? `${openCount} open now` : "";
    if (map) filterMap(map, visible);

    // Grid until there is a category, a search or a filter; then the list.
    const list = !!(cat || term || openOnly || me);
    homeView.hidden = list;
    listView.hidden = !list;
    // Inside one category its name on every row is noise.
    listView.classList.toggle("in-cat", !!cat);
    if (list) {
      const c = categories[cat];
      const title = $("l-title");
      title.textContent = term ? `Results for “${term}”` : c ? c.en : openOnly ? "Open now" : "Nearest first";
      if (!term && c) {
        const hi = document.createElement("span");
        hi.lang = "hi";
        hi.textContent = c.hi;
        title.append(hi);
      }
      $("l-count").textContent = `${visible.length} ${visible.length === 1 ? "place" : "places"}`;
    }
    if (list !== inList) {
      inList = list;
      window.scrollTo({ top: 0, behavior: "smooth" });
      sheet.scrollTo({ top: 0, behavior: "smooth" });
    }
  }

  function sortByDistance() {
    const d = me ? new Map(rows.map((r) => [r, metres(me!, [+r.dataset.lat!, +r.dataset.lng!])])) : undefined;
    for (const r of rows) {
      const el = r.querySelector<HTMLElement>(".dist")!;
      el.textContent = d ? distLabel(d.get(r)!) : "";
      el.hidden = !d;
    }
    [...rows].sort((a, b) => (d ? d.get(a)! - d.get(b)! : order.get(a)! - order.get(b)!)).forEach((r) => r.parentElement!.append(r));
  }

  function setNear(on: boolean) {
    nearBtn.setAttribute("aria-pressed", String(on));
    nearLabel.textContent = on ? "Nearest first" : "Near me";
    if (!on) me = undefined;
    sortByDistance();
    apply();
  }

  // The hash is the category: #food opens it, no hash is the grid.
  function fromHash() {
    const h = location.hash.slice(1);
    cat = h in categories ? h : "";
    apply();
  }
  addEventListener("hashchange", fromHash);
  const clearHash = () => history.pushState(null, "", location.pathname + location.search);

  q.addEventListener("input", apply);
  openBtn.addEventListener("click", () => {
    openOnly = !openOnly;
    openBtn.setAttribute("aria-pressed", String(openOnly));
    apply();
  });
  nearBtn.addEventListener("click", () => {
    if (me) return setNear(false);
    nearLabel.textContent = "Finding you…";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        me = [pos.coords.latitude, pos.coords.longitude];
        setNear(true);
        if (map) showMe(map, me[1], me[0]);
      },
      () => (nearLabel.textContent = "Location is off"),
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  // Reset everything back to the grid. The stone also looks at the whole town again.
  function reset() {
    q.value = "";
    cat = "";
    openOnly = false;
    openBtn.setAttribute("aria-pressed", "false");
    rows.forEach((r) => r.classList.remove("picked"));
    if (location.hash) clearHash();
    setNear(false);
  }
  $("back").addEventListener("click", (e) => {
    e.preventDefault();
    reset();
  });
  $("home").addEventListener("click", () => {
    reset();
    window.scrollTo({ top: 0, behavior: "smooth" });
    sheet.scrollTo({ top: 0, behavior: "smooth" });
    if (map) showTown(map);
  });

  // /?q=sim opens with that search, so guide pages can link straight to a search.
  q.value = new URLSearchParams(location.search).get("q") ?? "";
  fromHash();

  function pick(slug: string) {
    const row = document.querySelector<HTMLElement>(`.row[data-slug="${slug}"]`);
    if (!row) return;
    // From the grid, open the pin's category first so its row exists on screen.
    if (listView.hidden) {
      cat = row.dataset.cat!;
      history.pushState(null, "", `#${cat}`);
      apply();
    }
    rows.forEach((r) => r.classList.toggle("picked", r === row));
    row.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  document.querySelectorAll<HTMLElement>(".tmap").forEach((b) =>
    b.addEventListener("click", () => {
      const slug = b.dataset.pin!;
      if (!(map && showPin(map, slug, +b.dataset.lng!, +b.dataset.lat!))) pick(slug);
    }),
  );

  const el = $("map");
  initMap(el, JSON.parse(el.dataset.points!), pick)
    .then((m) => {
      map = m;
      m.on("load", apply);
      // 3D pulls ~1 MB of buildings, so only offer it on phones that can take it.
      const mem = (navigator as any).deviceMemory;
      const three = $("three") as HTMLButtonElement;
      if (!mem || mem >= 3) {
        three.hidden = false;
        three.setAttribute("aria-pressed", "false");
        three.addEventListener("click", () => {
          const on = three.getAttribute("aria-pressed") !== "true";
          set3D(m, on);
          three.setAttribute("aria-pressed", String(on));
          three.querySelector("span")!.textContent = on ? "2D" : "3D";
        });
      }
    })
    .catch((e) => {
      console.error(e);
      el.innerHTML = '<p style="padding:90px 20px 0 120px;color:var(--muted)">The map needs a newer browser. Every place is listed below.</p>';
    });
</script>
