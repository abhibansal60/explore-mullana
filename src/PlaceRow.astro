---
import Icon from "./Icon.astro";
import { categories, directions, searchText, site, type Place } from "./data";
const { place } = Astro.props as { place: Place };
const c = categories[place.category];
const claim = `Hi, I run ${place.name} in Mullana. I'd like to add our phone number and hours to Explore Mullana.`;
---
<article class="row place" style={`--cat:${c.color}`} data-slug={place.slug} data-cat={place.category}
  data-search={searchText(place)} data-lat={place.lat} data-lng={place.lng}>
  <div class="main">
    <h2><a href={`/place/${place.slug}/`}>{place.name}</a></h2>
    <span class="sub">
      <span class="catname">{c.en}</span>
      <span>Not checked yet</span>
      <span class="dist" hidden></span>
      <a class="claim" data-tap="claim" href={`https://wa.me/${site.reportWhatsApp}?text=${encodeURIComponent(claim)}`}>Own this place?</a>
    </span>
  </div>
  <div class="acts">
    <a class="ib" data-tap="directions" href={directions(place)} aria-label={`Directions to ${place.name}`} title={`Directions to ${place.name}`}><Icon name="route" /></a>
  </div>
</article>

<style>
  h2 { font-size: 17px; font-weight: 650; line-height: 1.2; }
  h2 a { text-decoration: none; }
  .claim { margin-left: auto; font-size: 13.5px; padding: 4px 0; color: var(--muted); text-underline-offset: 3px; }
</style>
