---
import Icon from "./Icon.astro";
import { categories, directions, searchText, site, type Place } from "./data";
const { place } = Astro.props as { place: Place };
const c = categories[place.category];
const claim = `Hi, I run ${place.name} in Mullana. I'd like to add our phone number and hours to Explore Mullana.`;
---
<article class="row place" style={`--cat:${c.color}`} data-slug={place.slug} data-cat={place.category}
  data-search={searchText(place)} data-lat={place.lat} data-lng={place.lng}>
  <h2>{place.name}</h2>
  <span class="cat">{c.en} <span lang="hi">{c.hi}</span></span>
  <div class="links">
    <a data-tap="directions" href={directions(place)}><Icon name="route" />Directions</a>
    <a data-tap="claim" href={`https://wa.me/${site.reportWhatsApp}?text=${encodeURIComponent(claim)}`}>Own this place?</a>
    <span class="dist" hidden></span>
  </div>
</article>

<style>
  .row { position: relative; padding: 12px 0 12px 16px; border-bottom: 1px solid var(--line); scroll-margin-top: 30vh; }
  .row::before { content: ""; position: absolute; left: 0; top: 14px; bottom: 14px; width: 4px; border-radius: 2px; border: 1.5px solid var(--cat); box-sizing: border-box; }
  .row.picked { background: color-mix(in srgb, var(--cat) 8%, transparent); }
  h2 { font-size: 19px; font-weight: 650; margin: 0; line-height: 1.2; }
  .cat { display: block; color: var(--muted); font-size: 15px; margin-top: 2px; }
  .cat span { margin-left: 6px; font-family: "Anek Devanagari", var(--font); }
  .links { display: flex; align-items: center; gap: 18px; margin-top: 2px; font-size: 15px; font-weight: 600; }
  .links a { display: inline-flex; align-items: center; gap: 5px; min-height: 36px; text-underline-offset: 3px; }
  .links :global(svg) { width: 16px; height: 16px; }
  .dist { margin-left: auto; color: var(--muted); }
</style>
